<local:ThemedDialogWindow x:Class="CursorManager.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CursorManager"
        Title="軟體更新" Height="480" Width="520" MinHeight="400" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft JhengHei UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Name="TxtHeadline" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Name="TxtCurrentVersion" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource DialogCardBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Name="TxtReleaseNotes" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <ProgressBar Name="ProgressDownload" Height="8" Minimum="0" Maximum="1"
                         Visibility="Collapsed" Margin="0,0,0,6"/>
            <TextBlock Name="TxtProgress" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Name="TxtFooterNote" TextWrapping="Wrap" FontSize="10.5"
                   FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Name="BtnManualDownload" Content="🌐 手動下載" MinWidth="96" Height="34" Margin="0,0,8,8"
                    Click="BtnManualDownload_Click" Cursor="Hand" Padding="12,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Name="BtnLater" Content="稍後" MinWidth="72" Height="34" Margin="0,0,8,8"
                    Click="BtnLater_Click" Cursor="Hand" Padding="12,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Name="BtnPrimary" Content="下載更新" MinWidth="120" Height="34" Margin="0,0,0,8"
                    Click="BtnPrimary_Click" IsDefault="True" Cursor="Hand" Padding="14,0"
                    FontWeight="Bold" Background="#1E66F5" Foreground="#FFFFFF" BorderBrush="#7287FD">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7287FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </WrapPanel>
    </Grid>
</local:ThemedDialogWindow>
