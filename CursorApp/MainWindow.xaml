<Window x:Class="CursorManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CursorManager"
        mc:Ignorable="d"
        Title="鼠標一鍵套用工具" 
        Height="896" Width="1390"
        MinHeight="762" MinWidth="1232"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft JhengHei UI, sans-serif"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}"/>
                                <Setter Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonHoverForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E66F5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7287FD"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7287FD"/>
                                <Setter Property="BorderBrush" Value="#B4BEFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#04A5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonHoverForegroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu Dark Theme -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <Grid>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderColorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- Must live in Window.Resources (not inside a Style Setter): Click handlers nested in
             Setter.Value break IComponentConnector connectionId wiring at runtime. -->
        <ContextMenu x:Key="LibraryThemeContextMenu" x:Shared="false">
            <MenuItem Header="✏️ 重新命名此主題" Click="MenuRenameTheme_Click"/>
            <MenuItem Header="📂 開啟所在資料夾" Click="MenuOpenFolder_Click"/>
            <Separator/>
            <MenuItem Header="🗑️ 刪除此主題" Click="MenuDeleteTheme_Click" Foreground="#F38BA8"/>
        </ContextMenu>
        <ContextMenu x:Key="SessionThemeContextMenu" x:Shared="false">
            <MenuItem Header="✏️ 重新命名顯示名稱" Click="MenuRenameTheme_Click"/>
            <MenuItem Header="📂 開啟所在資料夾" Click="MenuOpenFolder_Click"/>
            <MenuItem Header="📦 存入鼠標庫" Click="MenuSaveTemporaryTheme_Click"/>
            <Separator/>
            <MenuItem Header="❎ 從列表移除" Click="MenuDeleteTheme_Click" Foreground="#F38BA8"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootScaleGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Drag Area -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status & Actions -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Drag & Drop Banner + Title -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✨" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="鼠標一鍵套用器" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="拖曳資料夾至此視窗即可自動配對並立即生效" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="23,2,0,0"/>
                </StackPanel>

                <!-- Big Drag & Drop Dropzone Button -->
                <Border Grid.Column="1" 
                        Name="DropZoneBorder"
                        Background="{DynamicResource CardItemInnerBackgroundBrush}" 
                        BorderBrush="{DynamicResource PrimaryAccent}" 
                        BorderThickness="1.5" 
                        CornerRadius="8" 
                        Padding="10,6"
                        Cursor="Hand"
                        Margin="8,0"
                        MouseDown="DropZone_MouseDown"
                        AllowDrop="True"
                        DragOver="Window_DragOver"
                        Drop="Window_Drop">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="拖曳資料夾或點此手動選擇" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Quick Action: Open Mouse Settings & Storage Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 擷取鼠標" Click="BtnCaptureCurrentSystem_Click" Padding="8,5" FontSize="11.5" Margin="0,0,6,0"
                            ToolTip="將目前正在使用的鼠標直接存為新主題"/>
                    <Button Content="⚙️ 設定" Click="OpenSettings_Click" Padding="8,5" FontSize="11.5" Margin="0,0,6,0"
                            ToolTip="資料夾位置、鼠標大小與外觀設定"/>
                    <Button Content="🖱️ 系統設定" Click="OpenWindowsMouseSettings_Click" Padding="8,5" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="348" MinWidth="246" MaxWidth="504"/> <!-- Left Character List -->
                <ColumnDefinition Width="2"/>                                 <!-- Splitter -->
                <ColumnDefinition Width="*"/>                                  <!-- Right Slots Grid -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Character & Theme Library -->
            <Grid Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="14,10,14,6">
                    <Grid>
                        <TextBlock Text="內建鼠標庫" FontSize="14" FontWeight="Bold" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtThemeCount" Text="0 個主題" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Search Box -->
                <Border Grid.Row="1" Margin="12,0,12,8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <TextBox Grid.Column="1" Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                 FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"
                                 CaretBrush="{DynamicResource PrimaryAccent}"/>
                        <TextBlock Grid.Column="1" Text="搜尋主題或名稱..." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"/>
                    </Grid>
                </Border>

                <!-- Themes ListBox -->
                <ListBox Grid.Row="2" Name="LstThemes" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LstThemes_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Padding="6,0,6,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cursor Icon Preview -->
                                <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource CardItemInnerBackgroundBrush}" CornerRadius="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Image Source="{Binding PreviewImage}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource UiFontFamily}" VerticalAlignment="Center"/>
                                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" VerticalAlignment="Center"
                                                Background="#A6E3A133" BorderBrush="#A6E3A188" BorderThickness="1"
                                                Visibility="{Binding IsCurrentlyInUse, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
                                            <TextBlock Text="現在使用" FontSize="9" FontWeight="SemiBold" Foreground="#A6E3A1"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- File count badge -->
                                <Border Grid.Column="2" Background="{DynamicResource BorderColorBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" MinWidth="52">
                                    <TextBlock Text="{Binding FileCount, StringFormat='{}{0} 圖標'}" FontSize="10" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThemeItem_PreviewMouseRightButtonDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ThemeItemBorder"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="2,3"
                                                Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThemeItemBorder" Property="Background" Value="{DynamicResource ItemHoverBackgroundBrush}"/>
                                                <Setter TargetName="ThemeItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ThemeItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBackgroundBrush}"/>
                                                <Setter TargetName="ThemeItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="ThemeItemBorder" Property="Background" Value="{DynamicResource ItemSelectedHoverBackgroundBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColorBrush}"/>

            <!-- RIGHT PANEL: Current Folder & 15 Slots Grid -->
            <Grid Grid.Column="2" Background="{DynamicResource ContentBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Folder Info Header -->
                    <RowDefinition Height="*"/>    <!-- 15 Slots ScrollViewer Grid -->
                </Grid.RowDefinitions>

                <!-- Current Folder Header -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Name="TxtCurrentThemeTitle" Text="未選擇任何主題" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtCurrentFolderPath" Text="請從左側選擇或將資料夾拖曳進來" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource LatinFontFamily}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 重新配對本目錄" Click="BtnRematch_Click" Padding="10,5" FontSize="11" VerticalAlignment="Center"
                                ToolTip="重新掃描目前資料夾內的 .ani / .cur 檔案，並重新自動配對 15 項鼠標（檔名有變更或手動替換圖檔時使用）"/>
                    </Grid>
                </Border>

                <!-- 15 Cursor Slots Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                    <ListBox Name="ItemsCursorSlots" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Preview Box -->
                                    <Border Grid.Column="0" Background="{DynamicResource SlotPreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid>
                                            <Image Source="{Binding PreviewImage}" Width="32" Height="32" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="✕" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MissingSlotIconBrush}"
                                                       Visibility="{Binding HasFile, Converter={x:Static local:InverseBooleanToVisibilityConverter.Instance}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Slot Info -->
                                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{Binding HasFile, Converter={x:Static local:HasFileToTextBrushConverter.Instance}}"
                                                   FontFamily="{StaticResource LatinFontFamily}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding FilePath}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SlotCardBorder"
                                                    Width="248" Height="88"
                                                    Background="{DynamicResource CardItemInnerBackgroundBrush}"
                                                    BorderBrush="{Binding HasFile, Converter={x:Static local:HasFileToBorderBrushConverter.Instance}}"
                                                    BorderThickness="2"
                                                    CornerRadius="8"
                                                    Margin="5"
                                                    Padding="10,8"
                                                    Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource SlotHoverBackgroundBrush}"/>
                                                    <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource SlotSelectedBackgroundBrush}"/>
                                                    <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource ItemSelectedHoverBackgroundBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS & ACTION BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mouse size -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="鼠標大小" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                    <Slider Grid.Column="1" Name="SliderPointerSize" Style="{StaticResource PointerSizeSlider}"
                            ValueChanged="SliderPointerSize_ValueChanged"/>
                    <TextBlock Grid.Column="2" Name="TxtPointerSizeLabel" Text="32 PX" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource PrimaryAccent}" MinWidth="56"
                               FontFamily="{DynamicResource LatinFontFamily}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="TxtStatusIcon" Text="💡" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Name="TxtStatusMessage" Text="已就緒。點擊「套用」即可使用" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="{DynamicResource CardItemInnerBackgroundBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Name="TxtVersion" Text="v2.9.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>

                        <Button Name="BtnCheckUpdate" Content="🔄 檢查更新" Style="{StaticResource SecondaryBtn}" Click="BtnCheckUpdate_Click"
                                FontSize="11" Padding="8,4" Margin="6,0,0,0" VerticalAlignment="Center"/>

                        <Button Name="BtnNewUpdateFound" Content="🚀 發現新版本！點擊下載" Click="BtnNewUpdateFound_Click"
                                Visibility="Collapsed" Margin="6,0,0,0" Padding="10,4" FontSize="11" FontWeight="Bold"
                                Background="#F38BA8" Foreground="#11111B" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnReapplyLast" Content="🔁 套用上次" Style="{StaticResource SecondaryBtn}" Click="BtnReapplyLast_Click"
                                Margin="0,0,8,0" Padding="12,8" ToolTip="重新套用上次主題"/>
                        <Button Content="🔄 恢復預設" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreDefault_Click" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Name="BtnApplyTheme" Content="✨ 套用" Style="{StaticResource PrimaryBtn}" Click="BtnApplyTheme_Click" Padding="24,9"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
