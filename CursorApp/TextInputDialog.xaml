<Window x:Class="CursorManager.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="輸入" Height="190" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft JhengHei UI, sans-serif">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="TxtPrompt" Text="請輸入：" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" Name="TxtValue" Background="{DynamicResource DialogInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}"
                 BorderThickness="1.5" Padding="8,6" FontSize="13" CaretBrush="{DynamicResource PrimaryAccent}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="取消" Width="75" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}"/>
            <Button Content="確定" Width="75" Height="30" Click="BtnOk_Click" IsDefault="True"
                    Background="#1E66F5" Foreground="#FFFFFF" BorderBrush="#7287FD" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
