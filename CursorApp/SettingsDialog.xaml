<Window x:Class="CursorManager.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="560" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft JhengHei UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Section 1: Folder Location -->
                <Border Background="{DynamicResource DialogCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 資料夾位置" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="TxtStoragePath" Background="{DynamicResource DialogInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}"
                                     BorderThickness="1" Padding="8,6" FontSize="12" CaretBrush="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="瀏覽..." Width="65" Height="30" Margin="6,0,0,0" Click="BtnBrowse_Click"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}" Cursor="Hand" FontSize="11"/>
                            <Button Grid.Column="2" Content="開啟目錄" Width="75" Height="30" Margin="6,0,0,0" Click="BtnOpenCurrent_Click"
                                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}" Cursor="Hand" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Mouse pointer size -->
                <Border Background="{DynamicResource DialogCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖱️ 鼠標大小" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1"/>

                        <Grid Margin="0,10,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="小" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" Name="SliderCursorSize" Style="{StaticResource PointerSizeSlider}"
                                    ValueChanged="SliderCursorSize_ValueChanged"/>
                            <TextBlock Grid.Column="2" Name="TxtCursorSizeLabel" Text="32 PX" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource PrimaryAccent}" MinWidth="56"
                                       FontFamily="{DynamicResource LatinFontFamily}"/>
                        </Grid>

                        <TextBlock Text="縮放方式" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <StackPanel>
                            <RadioButton Name="RadioScaleSystem" GroupName="ScaleModeGroup" Margin="0,0,0,6" Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock Text="系統縮放（一般；若無反應請改用強制像素縮放）" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton Name="RadioScaleForced" GroupName="ScaleModeGroup" Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock Text="強制像素縮放(進階)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: App UI Theme Mode -->
                <Border Background="{DynamicResource DialogCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🌗 介面主題" FontSize="14" FontWeight="Bold" Foreground="#89DCEB"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" Name="RadioAppThemeSystem" GroupName="AppThemeGroup" Margin="0,0,6,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="#313244" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="跟隨系統" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1" Name="RadioAppThemeDark" GroupName="AppThemeGroup" Margin="0,0,6,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="#181825" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="深色" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="2" Name="RadioAppThemeLight" GroupName="AppThemeGroup" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="#EFF1F5" BorderBrush="#BCC0CC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="淺色" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: UI Scale -->
                <Border Background="{DynamicResource DialogCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🔍 介面大小" FontSize="14" FontWeight="Bold" Foreground="#F9E2AF"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" Name="RadioUiScaleSmall" GroupName="UiScaleGroup" Margin="0,0,6,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock Text="小" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                            <RadioButton Grid.Column="1" Name="RadioUiScaleNormal" GroupName="UiScaleGroup" Margin="0,0,6,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock Text="標準" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                            <RadioButton Grid.Column="2" Name="RadioUiScaleLarge" GroupName="UiScaleGroup" Cursor="Hand" VerticalContentAlignment="Center">
                                <TextBlock Text="大" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Preview Slot Background Mode -->
                <Border Background="{DynamicResource DialogCardBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="🎨 預覽背景" FontSize="14" FontWeight="Bold" Foreground="#CBA6F7"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" Name="RadioBgTheme" GroupName="BgGroup" Margin="0,0,4,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#181825" Offset="0.5"/>
                                                <GradientStop Color="#EFF1F5" Offset="0.5"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="跟隨主題" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1" Name="RadioBgDark" GroupName="BgGroup" Margin="0,0,4,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="#11111B" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="深色" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="2" Name="RadioBgLight" GroupName="BgGroup" Margin="0,0,4,0" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="#F2F4F8" BorderBrush="#BCC0CC" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="淺色" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="3" Name="RadioBgChecker" GroupName="BgGroup" Cursor="Hand" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" Background="{StaticResource CheckerboardBrush}" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0"/>
                                    <TextBlock Text="透明" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="75" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click"
                    Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderColorBrush}" Cursor="Hand"/>
            <Button Content="儲存設定" Width="85" Height="32" Click="BtnSave_Click" IsDefault="True"
                    Background="#1E66F5" Foreground="#FFFFFF" BorderBrush="#7287FD" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
